---
import { url } from '../../utils/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/site';

export async function getStaticPaths() {
  // Drafts get pages in dev so you can preview them; they are never built for production.
  const posts = await getCollection('writing', (p) => import.meta.env.DEV || !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={`${post.data.title} — ${profile.name}`} description={post.data.description}>
  <article>
    <p class="small"><a href={url()}>← {profile.name}</a></p>
    <header>
      <h1>{post.data.title}</h1>
      <p class="small muted">
        {date}{post.data.draft && ' · Draft'}{post.data.tags.length > 0 && ` · ${post.data.tags.join(', ')}`}
      </p>
      <p class="dek">{post.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    font-size: 1.9rem;
    margin: 1rem 0 0.4rem;
  }
  .dek {
    font-size: 1.15rem;
    color: var(--soft);
    margin: 0;
  }
</style>
