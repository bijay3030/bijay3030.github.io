---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Project from '../components/Project.astro';
import Clock from '../components/Clock.astro';
import StructuredData from '../components/StructuredData.astro';
import portrait from '../assets/portrait.jpg';
import {
  profile,
  about,
  aiWorkflow,
  projects,
  openSource,
  experience,
  skills,
  education,
  testimonials,
} from '../data/site';

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const published = posts.filter((p) => !p.data.draft);

// Unapproved testimonials appear only in dev, so the live site never shows words nobody signed off on.
const quotes = testimonials.filter((t) => t.approved || import.meta.env.DEV);
// Show the employer once when every role was at the same company.
const company = experience.every((j) => j.company === experience[0].company) ? experience[0] : null;

const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base>
  <StructuredData slot="head" />

  <header class="intro">
    <Image src={portrait} alt="Bijay Subedi" width={192} height={192} class="portrait" loading="eager" />
    <h1>{profile.name}</h1>
    <p class="tagline">{profile.tagline}</p>
    <p class="statement">{profile.statement}</p>
    <p class="links">
      <a href={url(profile.resume)}>Résumé</a> · {profile.links.map((l) => <><a href={l.href} rel="me">{l.label}</a> · </>)}
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <p class="status small muted">{profile.availability}. <Clock /></p>
  </header>

  <main>
    <Section id="about" title="About">
      {about.map((p) => <p>{p}</p>)}
      <p><strong>How I ship a feature with AI:</strong></p>
      <ol class="workflow">
        {
          aiWorkflow.map((w) => (
            <li>
              <strong>{w.step}:</strong> {w.detail}
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="work" title="Selected work">
      {projects.map((p) => <Project project={p} />)}
    </Section>

    {
      quotes.length > 0 && (
        <section class="quotes" aria-label="What people say">
          {quotes.map((t) => (
            <figure>
              {!t.approved && <p class="pending small">Pending approval, not live</p>}
              <blockquote>“{t.quote}”</blockquote>
              <figcaption class="small">
                {t.href ? <a href={t.href}>{t.name}</a> : t.name}, {t.title}
                <span class="muted"> ({t.relationship})</span>
              </figcaption>
            </figure>
          ))}
        </section>
      )
    }

    <Section id="experience" title="Experience">
      {
        company && (
          <p class="employer">
            <a href={company.href}>{company.company}</a>
          </p>
        )
      }
      {
        experience.map((job) => (
          <article class="job">
            <h3>
              {job.title}
              {!company && (
                <>
                  , <a href={job.href}>{job.company}</a>
                </>
              )}{' '}
              <span class="period">{job.period}</span>
            </h3>
            <p class="muted">{job.summary}</p>
            <ul>
              {job.metrics.map((m) => (
                <li>
                  <strong>{m.value}</strong> {m.label}
                </li>
              ))}
              {job.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))
      }
      <p class="education">
        <strong>Education:</strong>{' '}{education.map((e) => `${e.degree}, ${e.school} (${e.years})`).join('; ')}
      </p>
    </Section>

    {
      openSource.length > 0 && (
        <Section id="open-source" title="Open source">
          {openSource.map((o) => (
            <article>
              <h3>
                <a href={o.href}>{o.name}</a>
              </h3>
              <p>{o.summary}</p>
              <ul>
                {o.notes.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
              <p class="small muted">Built with {o.stack.join(', ')}.</p>
            </article>
          ))}
        </Section>
      )
    }

    {
      // Writing appears only once a post is published, so unfinished drafts stay off the page.
      published.length > 0 && (
        <Section id="writing" title="Writing">
          <ul>
            {published.map((p) => (
              <li>
                <a href={url(`writing/${p.id}/`)}>{p.data.title}</a> <span class="muted small">{fmtDate(p.data.date)}</span>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <Section id="skills" title="Toolkit">
      <ul class="skills">
        {
          skills.map((s) => (
            <li>
              <strong>{s.group}:</strong> {s.items.join(', ')}
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="contact" title="Contact">
      <p>
        Hiring a senior Rails engineer? Email me at <a href={`mailto:${profile.email}`}>{profile.email}</a>.
      </p>
      <p class="small muted">{profile.utcOffset}, with {profile.overlap}.</p>
    </Section>
  </main>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1.5rem;
    align-items: start;
  }
  .intro > :not(.portrait) {
    grid-column: 1 / -1;
  }
  .intro > h1 {
    grid-column: 1;
    grid-row: 1;
  }
  .intro > .tagline {
    grid-column: 1;
    grid-row: 2;
  }
  .portrait {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 96px;
    height: 96px;
    border-radius: 8px;
    object-fit: cover;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 0.25rem;
  }
  .tagline {
    margin: 0 0 0.75rem;
    color: var(--muted);
  }
  .statement {
    font-size: 1.25rem;
    line-height: 1.45;
    margin-bottom: 0.9rem;
  }
  .links {
    margin-bottom: 0.4rem;
    overflow-wrap: anywhere;
  }

  .workflow {
    margin-bottom: 0;
  }

  .quotes {
    margin-top: 2.5rem;
  }
  .quotes figure {
    margin: 0 0 1.5rem;
  }
  .quotes blockquote {
    margin: 0 0 0.4rem;
    padding-left: 1rem;
    border-left: 3px solid var(--rule);
    font-style: italic;
  }
  .pending {
    margin: 0 0 0.3rem;
    color: #b42318;
  }

  .employer {
    margin-bottom: 0.75rem;
    font-weight: 700;
  }
  .job + .job {
    margin-top: 1.5rem;
  }
  .job h3 {
    font-size: 1.05rem;
    margin: 0 0 0.2rem;
  }
  .period {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .job p {
    margin-bottom: 0.5rem;
  }
  .education {
    margin-top: 1.5rem;
  }

  @media (max-width: 30rem) {
    .portrait {
      width: 72px;
      height: 72px;
    }
    .statement {
      font-size: 1.15rem;
    }
  }
</style>
