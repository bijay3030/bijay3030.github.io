---
// A plain page section: a heading and its content, always visible.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <slot />
</section>

<style>
  section {
    margin-top: 3rem;
  }
  h2 {
    font-size: 1.35rem;
    margin: 0 0 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--rule);
  }
</style>
