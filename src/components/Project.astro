---
// A project: a short summary anyone can skim, and the full case study behind "Read the case study".
import type { Project } from '../data/site';
import Architecture from './Architecture.astro';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
---

<article class="project" id={p.id}>
  <h3>
    {p.name} <span class="domain">({p.domain})</span>
  </h3>
  <p class="summary">{p.summary}</p>
  <p class="shift">
    <span class="muted">Before:</span> {p.before}. <span class="muted">After:</span> {p.after}.
  </p>
  <p class="scale small muted">{p.scale.join(' · ')}</p>

  <details>
    <summary>Read the case study</summary>
    <div class="case">
      <p class="small">
        <strong>Client:</strong>{' '}{p.client}
        {
          p.href && (
            <>
              {' · '}
              <a href={p.href}>{new URL(p.href).host}</a>
            </>
          )
        }
        <br />
        <strong>Flow:</strong>{' '}{p.flow.join(' → ')}
      </p>

      <h4>Problem</h4>
      <p>{p.problem}</p>

      <h4>Architecture</h4>
      <Architecture arch={p.architecture} name={p.name} />

      <h4>My part</h4>
      <ul>{p.contribution.map((c) => <li>{c}</li>)}</ul>

      <h4>Key decisions</h4>
      <ul>
        {
          p.decisions.map((d) => (
            <li>
              <strong>{d.title}.</strong> {d.body}
            </li>
          ))
        }
      </ul>

      <h4>Impact</h4>
      <ul>{p.results.map((r) => <li>{r}</li>)}</ul>

      <p class="small muted">Built with {p.stack.join(', ')}.</p>
    </div>
  </details>
</article>

<style>
  .project + .project {
    margin-top: 2rem;
  }
  h3 {
    font-size: 1.15rem;
    margin: 0 0 0.3rem;
  }
  .domain {
    font-weight: 400;
    color: var(--muted);
  }
  .summary {
    margin-bottom: 0.3rem;
  }
  .shift {
    margin-bottom: 0.2rem;
  }
  .scale {
    margin-bottom: 0.4rem;
  }
  summary {
    cursor: pointer;
    color: var(--link);
    width: fit-content;
  }
  summary:hover {
    text-decoration: underline;
  }
  .case {
    margin-top: 0.75rem;
    padding-left: 1rem;
    border-left: 3px solid var(--rule);
  }
  h4 {
    font-size: 1rem;
    margin: 1.25rem 0 0.4rem;
  }
</style>
