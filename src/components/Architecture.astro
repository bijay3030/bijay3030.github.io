---
// A layered architecture diagram in plain HTML: each tier is a row of boxes, joined by labelled arrows.
// Real text (not an image), so it reflows on phones and stays readable to crawlers and screen readers.
import type { Architecture } from '../data/site';

interface Props {
  arch: Architecture;
  name: string;
}

const { arch, name } = Astro.props;
---

<figure class="arch" aria-label={`Architecture of ${name}`}>
  {
    arch.tiers.map((tier, i) => (
      <>
        {i > 0 && <p class="via small muted">↓ {tier.via}</p>}
        <section class:list={['tier', { core: tier.core }]}>
          <p class="tier-name small">{tier.label}</p>
          <ul style={`--n: ${tier.nodes.length}`}>
            {tier.nodes.map((n) => (
              <li>
                <strong>{n.name}</strong>
                <span class="small muted">{n.note}</span>
              </li>
            ))}
          </ul>
        </section>
      </>
    ))
  }
  {arch.caption && <figcaption class="small muted">{arch.caption}</figcaption>}
</figure>

<style>
  .arch {
    margin: 0 0 1rem;
  }
  .tier-name {
    margin: 0 0 0.3rem;
    font-weight: 700;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 0.5rem;
  }
  li {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    line-height: 1.35;
  }
  .core li {
    background: var(--box);
  }
  li strong {
    font-size: 0.95rem;
  }
  .via {
    margin: 0.35rem 0 0.35rem 0.5rem;
  }
  figcaption {
    margin-top: 0.6rem;
  }
  @media (max-width: 34rem) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
